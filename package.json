{
  "name": "gustave",
  "version": "0.1.0",
  "description": "A custom coding agent distribution based on pi.",
  "type": "module",
  "bin": {
    "gustave": "./bin/gustave.mjs"
  },
  "keywords": [
    "coding-agent",
    "pi-package",
    "pi",
    "agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@citedy/game-sounds": "^3.0.1",
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "@getpaseo/cli": "^0.1.110",
    "@plannotator/pi-extension": "^0.24.1",
    "@sveltejs/mcp": "^0.1.25",
    "agent-browser": "^0.32.2",
    "mcporter": "^0.12.3",
    "pi-powerline-footer": "^0.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./node_modules/pi-powerline-footer/index.ts",
      "./node_modules/@plannotator/pi-extension",
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@google/genai",
      "agent-browser",
      "node-pty",
      "protobufjs"
    ]
  },
  "scripts": {
    "gustave": "node ./bin/gustave.mjs",
    "install-bin": "node ./bin/gustave.mjs install-bin",
    "self-test": "node ./bin/gustave.mjs self-test",
    "hooks:install": "git config core.hooksPath git-hooks",
    "format": "biome format --write . && shfmt -w install.sh git-hooks/*",
    "lint:biome": "biome lint .",
    "lint:markdown": "markdownlint-cli2",
    "lint:shell": "shellcheck install.sh git-hooks/* && shfmt -d install.sh git-hooks/*",
    "lint": "pnpm lint:biome && pnpm lint:markdown && pnpm lint:shell",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "precommit": "pnpm lint && pnpm typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm test && node ./bin/gustave.mjs self-test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "markdownlint-cli2": "^0.23.1",
    "typescript": "^7.0.2"
  }
}
